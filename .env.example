# =====================================================================================
# STILLDESK: ENVIRONMENT VARIABLES (template). Safe to commit: it contains NO real secrets.
# Do NOT put real values in this file. Copy the parts you need:
#   - WEBSITE part  -> apps/web/.env.local     (the browser can see NEXT_PUBLIC_ values: never put secrets there)
#   - API part      -> apps/api/.env           (server only; never committed; never sent to the browser)
# Each app also has its own short example: apps/web/.env.example and apps/api/.env.example
# =====================================================================================

# ---------- WEBSITE (apps/web/.env.local) ----------
# Public address of the website. REQUIRED for a production build. Use your real https:// domain once you have one.
# For local work use http://localhost:3000 (a production build refuses localhost on purpose).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public address of the API (no trailing slash). Leave EMPTY while the API is not running:
# the site still works and the waitlist form honestly says sign-ups are not connected.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Analytics / monitoring: leave empty. Nothing is loaded until you approve a provider (see docs/SECURITY.md).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ERROR_MONITORING=

# ---------- API (apps/api/.env) ----------
NODE_ENV=development
PORT=4000
# Where the website lives (used for email links and redirects). https:// in production.
SITE_URL=http://localhost:3000
# Public address of this API (used in confirmation-email links). REQUIRED in production, https://
API_URL=http://localhost:4000
# Websites allowed to call the API from a browser, comma-separated, exact origins. No wildcards.
CORS_ORIGINS=http://localhost:3000
# MongoDB connection string (MongoDB Atlas). SECRET. Example shape only:
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/stilldesk?retryWrites=true&w=majority
# Random secret for signing survey/unsubscribe links. SECRET. 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=
# Set to 1 if the API runs behind ONE proxy / load balancer (Render, Railway, Fly, Vercel...). Needed for correct rate limits.
TRUST_PROXY=0

# --- Email (Resend). Without these the API runs, but sign-ups answer "temporarily unavailable". ---
# "resend" sends real email. "console" prints the links in the API terminal instead (development ONLY; refused in production).
EMAIL_MODE=resend
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g.  Stilldesk <hello@yourdomain>
EMAIL_FROM=
EMAIL_REPLY_TO=
# Where "new feedback" notifications go (optional). Also used as the support address.
SUPPORT_EMAIL=
# Optional wording used inside emails (leave empty until decided; emails say "an early-bird offer").
EARLY_BIRD_OFFER=
EMAIL_POSTAL_ADDRESS=
